            </a>

            <!-- Link Card 3 -->
            <a href="#" class="link-card" target="_blank">
                <div class="card-icon">
                    <i class="fab fa-tiktok"></i>
                </div>
                <div class="card-info">
                    <span class="tag">OFFICIAL TIKTOK</span>
                    <span class="title">FOLLOW US</span>
